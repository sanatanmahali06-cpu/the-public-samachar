generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Reporter {
  id           Int      @id @default(autoincrement())
  name         String
  username     String   @unique
  passwordHash String
  email        String?
  phone        String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  news         News[]
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  news      News[]
}

model News {
  id            Int           @id @default(autoincrement())
  title         String
  slug          String        @unique
  excerpt       String?
  content       String
  author        String?
  image         String?
  status        String        @default("draft")
  isBreaking    Boolean       @default(false)
  state         String?
  city          String?
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  views         Int           @default(0)
  categoryId    Int?
  reporterId    Int?
  video         String?
  category      Category?     @relation(fields: [categoryId], references: [id])
  reporter      Reporter?     @relation(fields: [reporterId], references: [id])
  bannerImageUrl      String?
  bannerAffiliateUrl  String?
  bannerImageUrl2     String?
  bannerAffiliateUrl2 String?
  shoppingDeals       NewsProduct[]
}

model Manager {
  id           Int      @id @default(autoincrement())
  name         String
  username     String   @unique
  passwordHash String
  email        String?
  phone        String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
}

model Product {
  id          Int           @id @default(autoincrement())
  name        String
  description String?
  price       Float
  imageUrl    String?
  meeshoUrl   String
  active      Boolean       @default(true)
  showInShoppingDeals Boolean @default(false)
  showInBestDeals     Boolean @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  newsDeals   NewsProduct[]
}

model NewsProduct {
  newsId    Int
  productId Int
  position  Int     @default(1)
  news      News    @relation(fields: [newsId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([newsId, productId])
  @@unique([newsId, position])
}

model Banner {
  id          Int      @id @default(autoincrement())
  name        String
  imageUrl    String
  targetUrl   String
  placements  String[] @default([])
  interval    Int      @default(2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
